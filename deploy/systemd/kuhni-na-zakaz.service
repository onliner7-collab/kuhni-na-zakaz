[Unit]
Description=kuhni-na-zakaz next app
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__/artifacts/kuhni-na-zakaz
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=__APP_DIR__/artifacts/kuhni-na-zakaz/.env
ExecStart=/usr/bin/env pnpm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
