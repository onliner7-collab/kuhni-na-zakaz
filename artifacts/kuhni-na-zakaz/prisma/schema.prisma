generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
}

enum ReviewStatus {
  NEW
  PENDING
  PUBLISHED
  REJECTED
  DELETED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  guestAccessCreated GuestAccess[]
  activityLogs       ActivityLog[]
  moderatedReviews   Review[]      @relation("ModeratedBy")
}

model GuestAccess {
  id                Int       @id @default(autoincrement())
  name              String
  createdById       Int
  createdBy         User      @relation(fields: [createdById], references: [id])
  allowedSections   String[]
  allowedActions    String[]
  loginToken        String    @unique @default(cuid())
  loginLogin        String?
  loginPasswordHash String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  activityLogs ActivityLog[]
}

model ActivityLog {
  id            Int          @id @default(autoincrement())
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id])
  guestAccessId Int?
  guestAccess   GuestAccess? @relation(fields: [guestAccessId], references: [id])
  action        String
  entity        String
  entityId      Int?
  details       Json         @default("{}")
  ip            String       @default("")
  userAgent     String       @default("")
  createdAt     DateTime     @default(now())
}

model Kitchen {
  id             Int      @id @default(autoincrement())
  externalId     String?  @unique
  title          String
  slug           String   @unique
  description    String   @default("")
  category       String
  style          String   @default("")
  material       String   @default("")
  priceFrom      Int      @default(0)
  priceTo        Int?
  features       String[]
  images         String[]
  mainImage      String   @default("")
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PortfolioCase {
  id              Int      @id @default(autoincrement())
  externalId      String?  @unique
  title           String
  shortTitle      String   @default("")
  slug            String   @unique
  city            String
  cityKey         String   @default("")
  region          String   @default("")
  district        String   @default("")
  kitchenType     String   @default("")
  area            Int      @default(0)
  layout          String   @default("")
  style           String   @default("")
  styleSlug       String   @default("")
  color           String   @default("")
  material        String   @default("")
  materials       String[] @default([])
  materialSlugs   String[]
  scenarioSlugs   String[]
  priceFrom       Int      @default(0)
  priceTo         Int      @default(0)
  priceNote       String   @default("Стоимость зависит от размеров, материалов и комплектации.")
  size            String   @default("")
  facades         String   @default("")
  countertop      String   @default("")
  fittings        String   @default("")
  workDuration    String   @default("")
  days            Int      @default(0)
  completedAt     String   @default("")
  description     String   @default("")
  task            String   @default("")
  constraints     String   @default("")
  solution        String   @default("")
  result          String   @default("")
  features        String[] @default([])
  relatedLocationSlugs String[] @default([])
  mainImage       String   @default("")
  images          String[]
  imageAlts       String[] @default([])
  imageCaptions   String[] @default([])
  alt             String   @default("")
  photosBefore    String[]
  photosAfter     String[]
  reviewIds       Int[]
  featured        Boolean  @default(false)
  order           Int      @default(0)
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  seoKeywords     String   @default("")
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id              Int          @id @default(autoincrement())
  name            String
  city            String
  region          String       @default("")
  phone           String       @default("")
  rating          Int
  text            String
  date            String       @default("")
  caseSlug        String       @default("")
  source          String       @default("website")
  sourceUrl       String       @default("")
  featured        Boolean      @default(false)
  managerNote     String       @default("")
  status          ReviewStatus @default(NEW)
  moderatedById   Int?
  moderatedBy     User?        @relation("ModeratedBy", fields: [moderatedById], references: [id])
  moderatedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
}

model BlogPost {
  id                   Int       @id @default(autoincrement())
  title                String
  slug                 String    @unique
  excerpt              String    @default("")
  content              String    @default("")
  category             String    @default("")
  tags                 String[]
  readTime             Int       @default(5)
  relatedCaseSlugs     String[]
  relatedStyleSlugs    String[]
  relatedScenarioSlugs String[]
  coverImage           String    @default("")
  seoTitle             String?
  seoDescription       String?
  published            Boolean   @default(false)
  publishedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model FAQItem {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  page     String @default("home")
  order    Int    @default(0)
}

model LocationPage {
  id              Int      @id @default(autoincrement())
  externalId      String?   @unique
  city            String
  slug            String   @unique
  region          String   @default("")

  title           String
  h1              String
  intro           String   @default("")
  description     String   @default("")

  priceFrom       Int      @default(900)
  deliveryCost    String   @default("")
  deliveryDays    Int      @default(1)
  measureCost     String   @default("Условия замера — по заявке")
  timelineText    String   @default("")

  visitDetails    String   @default("")
  installDetails  String   @default("")

  images          String[]
  areas           String[]
  workZone        String   @default("")
  mapEmbed        String   @default("")

  features        String[]
  faq             Json     @default("[]")

  localIntro      String   @default("")
  uniquePoints    Json     @default("[]")
  contentBlocks   Json     @default("[]")
  caseSlugs       String[]
  reviewIds       Int[]
  ctaHeadline     String   @default("")
  ctaSubtext      String   @default("")

  phone           String   @default("")
  address         String   @default("")

  seoTitle        String?
  seoDescription  String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Lead {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String
  city            String   @default("")
  comment         String   @default("")
  source          String   @default("website")
  formType        String   @default("contact")
  answers         Json     @default("{}")
  // Этап 10: персонализация
  configSessionId String?
  scenarioSlug    String   @default("")
  styleSlug       String   @default("")
  materialSlug    String   @default("")
  budgetLevel     String   @default("")
  // Менеджерский workflow
  status          String   @default("new")      // new | contacted | working | done | lost
  managerNote     String   @default("")
  assignedTo      String   @default("")
  createdAt       DateTime @default(now())

  visualProject   VisualProject?
}

// Этап 10: сохранённые конфигурации (анонимные, по sessionId)
model SavedConfig {
  id           Int      @id @default(autoincrement())
  sessionId    String   @unique
  answers      Json     @default("{}")
  tags         String[]
  styleSlug    String   @default("")
  materialSlug String   @default("")
  scenarioSlug String   @default("")
  budgetLevel  String   @default("")
  label        String   @default("")  // человекочитаемое резюме
  phone        String   @default("")  // если пользователь оставил телефон
  leadId       Int?                   // если конвертирован в заявку
  createdAt    DateTime @default(now())
}

// Этап 10: избранные проекты портфолио (анонимные, по sessionId)
model FavoriteCase {
  id        Int      @id @default(autoincrement())
  sessionId String
  caseSlug  String
  createdAt DateTime @default(now())

  @@unique([sessionId, caseSlug])
}

model StylePage {
  id                  Int      @id @default(autoincrement())
  externalId          String?   @unique
  slug                String   @unique
  title               String
  headline            String   @default("")
  description         String   @default("")
  intro               String   @default("")
  content             String   @default("")
  suitableFor         String[]
  pros                String[]
  cons                String[]
  careGuide           String[]
  pairsWith           String[]
  budgetLevel         String   @default("")
  priceFrom           Int      @default(0)
  image               String   @default("")
  relatedMaterials    String[]
  relatedCaseSlugs    String[]
  relatedScenarioSlugs String[]
  seoTitle            String   @default("")
  seoDescription      String   @default("")
  seoKeywords         String   @default("")
  order               Int      @default(0)
  published           Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model MaterialPage {
  id                  Int      @id @default(autoincrement())
  externalId          String?   @unique
  slug                String   @unique
  title               String
  headline            String   @default("")
  description         String   @default("")
  intro               String   @default("")
  content             String   @default("")
  pros                String[]
  cons                String[]
  suitableFor         String[]
  careGuide           String[]
  budgetLevel         String   @default("")
  pricePer            String   @default("")
  priceFrom           Int      @default(0)
  image               String   @default("")
  relatedStyles       String[]
  relatedCaseSlugs    String[]
  relatedScenarioSlugs String[]
  seoTitle            String   @default("")
  seoDescription      String   @default("")
  seoKeywords         String   @default("")
  order               Int      @default(0)
  published           Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model SiteSettings {
  id              Int    @id @default(1)
  siteName        String @default("КухниBY")
  phone           String @default("+375293720674")
  phoneDisplay    String @default("+375 (29) 372-06-74")
  phone2          String @default("")
  phoneDisplay2   String @default("")
  email           String @default("onliner7@gmail.com")
  address         String @default("222520, г. Борисов, ул. Дзержинского, д. 90, каб. 1а")
  addressMap      String @default("")
  workingHours    String @default("Пн–Сб 9:00–19:00, Вс 10:00–17:00")
  telegram        String @default("")
  viber           String @default("")
  whatsapp        String @default("")
  instagram       String @default("https://www.instagram.com/inside_home1983/")
  vk              String @default("")
  facebook        String @default("")
  youtube         String @default("")
  telegramBotToken String @default("")
  telegramChatId  String @default("")
  metaTitle       String @default("Кухни на заказ по Беларуси | КухниBY")
  metaDescription String @default("Кухни на заказ по всей Беларуси. Собственное производство. Гарантия фиксируется в договоре. Условия замера и 3D-проекта уточняются при заявке.")
}

model TelegramRecipient {
  id        Int      @id @default(autoincrement())
  label     String   @default("")
  chatId    String   @unique
  role      String   @default("moderator")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramNotificationLog {
  id           Int      @id @default(autoincrement())
  leadId       Int?
  recipientId  Int?
  chatId       String
  status       String
  errorMessage String   @default("")
  createdAt    DateTime @default(now())
}

model TelegramMessage {
  id             Int      @id @default(autoincrement())
  userTelegramId String
  username       String   @default("")
  firstName      String   @default("")
  messageText    String   @default("")
  createdAt      DateTime @default(now())
}

model StaticPage {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  content        String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomepageBlock {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  subtitle    String   @default("")
  description String   @default("")
  icon        String   @default("")
  href        String   @default("")
  badge       String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
}

model PriceRule {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  category    String
  label       String
  description String   @default("")
  value       Float
  unit        String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ──────────────────────────────────────────
// Конфигуратор кухни (Этап 6)
// ──────────────────────────────────────────

model ConfigStep {
  id        Int            @id @default(autoincrement())
  key       String         @unique
  question  String
  hint      String         @default("")
  type      String         @default("choice")  // "choice" | "multichoice"
  emoji     String         @default("")
  order     Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  options   ConfigOption[]
}

model ConfigOption {
  id          Int        @id @default(autoincrement())
  stepId      Int
  step        ConfigStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String     @default("")
  emoji       String     @default("")
  tags        String[]   // e.g. ["style:scandinavian", "budget:standard", "layout:corner"]
  order       Int        @default(0)
  active      Boolean    @default(true)
}

model ConfigResult {
  id        Int      @id @default(autoincrement())
  sessionId String   @default(cuid())
  answers   Json     // {"layout":"corner","style":"scandinavian",...}
  tags      String[] // агрегированные теги выбранных опций
  leadId    Int?
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────
// Визуальный конфигуратор кухни (Этап 1)
// ──────────────────────────────────────────

enum KitchenModuleType {
  LOWER
  UPPER
  TALL
  CORNER
  SINK
  DRAWER
  GLASS_DOOR
  LIFT_MECHANISM
}

enum KitchenLayoutType {
  STRAIGHT
  CORNER
  U_SHAPE
  ISLAND
  PENINSULA
  LINEAR_COLUMNS
  COMPACT
}

enum KitchenHandleType {
  STANDARD
  RECESSED
  PUSH_TO_OPEN
  INTEGRATED
}

enum CompatibilityRuleType {
  INCOMPATIBLE
  REQUIRES
  WARNING
}

// Модули кухни — нижние, верхние, пеналы, угловые и т.д.
model KitchenModule {
  id            Int               @id @default(autoincrement())
  name          String
  slug          String            @unique
  moduleType    KitchenModuleType
  widthCm       Int
  heightCm      Int
  depthCm       Int
  priceBase     Int               @default(0)
  imageUrl      String            @default("")
  description   String            @default("")
  tags          String[]
  isEnabled     Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// Шаблоны планировок кухни
model KitchenTemplate {
  id              Int               @id @default(autoincrement())
  name            String
  slug            String            @unique
  layoutType      KitchenLayoutType
  description     String            @default("")
  previewImageUrl String            @default("")
  modulesConfig   Json              @default("[]") // расположение модулей по умолчанию
  minWidthCm      Int?
  maxWidthCm      Int?
  isEnabled       Boolean           @default(true)
  isPublished     Boolean           @default(false)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// Фасады
model KitchenFacade {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  material        String   @default("") // mdf, plastic, enamel, veneer, solid_wood
  finish          String   @default("") // matte, gloss, textured
  colorHex        String   @default("")
  colorName       String   @default("")
  imageUrl        String   @default("")
  priceMultiplier Float    @default(1.0)
  isEnabled       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Столешницы
model KitchenCountertop {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  material      String   @default("") // laminate, stone, quartz, solid_surface, wood
  thicknessMm   Int      @default(38)
  colorName     String   @default("")
  imageUrl      String   @default("")
  pricePerMeter Int      @default(0)
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Скинали / фартуки
model KitchenSkinal {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  material        String   @default("") // glass, tile, acrylic, mdf
  colorName       String   @default("")
  imageUrl        String   @default("")
  pricePerSqMeter Int      @default(0)
  isEnabled       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Ручки и безручечные системы
model KitchenHandle {
  id            Int               @id @default(autoincrement())
  name          String
  slug          String            @unique
  handleType    KitchenHandleType
  material      String            @default("")
  finishName    String            @default("")
  imageUrl      String            @default("")
  pricePerPiece Int               @default(0)
  isEnabled     Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// Механизмы открывания (Aventos и аналоги, мягкое закрытие и т.д.)
model KitchenMechanism {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  brand         String   @default("") // Blum, Grass, Hettich
  mechanismType String   @default("") // lift, swing, push_open, drawer_soft_close
  imageUrl      String   @default("")
  pricePerPiece Int      @default(0)
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Встраиваемая техника
model KitchenAppliance {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  brand         String   @default("")
  applianceType String   @default("") // oven, hob, dishwasher, fridge, microwave, hood
  widthCm       Int?
  heightCm      Int?
  depthCm       Int?
  imageUrl      String   @default("")
  priceBase     Int      @default(0)
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Пользовательский визуальный проект
model VisualProject {
  id               Int      @id @default(autoincrement())
  sessionId        String?
  name             String   @default("Мой проект")
  roomConfig       Json     @default("{}") // размеры, стены, двери, окна, выступы
  modulePlacement  Json     @default("[]") // позиции модулей на плане
  materialsConfig  Json     @default("{}") // выбранные фасад, столешница и т.д.
  priceEstimate    Int      @default(0)
  isDraft          Boolean  @default(true)
  isArchived       Boolean  @default(false)
  leadId           Int?     @unique
  lead             Lead?    @relation(fields: [leadId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Правила совместимости между компонентами
model CompatibilityRule {
  id           Int                   @id @default(autoincrement())
  ruleType     CompatibilityRuleType
  sourceEntity String                // "facade" | "mechanism" | "module" | "handle"
  sourceSlug   String
  targetEntity String
  targetSlug   String
  message      String                @default("")
  isEnabled    Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

// Глобальные настройки конфигуратора (синглтон)
model KitchenConfiguratorSettings {
  id                   Int     @id @default(1)
  isEnabled            Boolean @default(true)
  defaultRoomWidthCm   Int     @default(300)
  defaultRoomDepthCm   Int     @default(250)
  defaultRoomHeightCm  Int     @default(250)
  shareTextTemplate    String  @default("Смотри мой проект кухни!")
  exportBrandingText   String  @default("Создано на kuhni.minsk.by")
  updatedAt            DateTime @updatedAt
}

model ScenarioPage {
  id              Int      @id @default(autoincrement())
  externalId      String?   @unique
  slug            String   @unique
  icon            String   @default("🏠")
  badge           String   @default("")
  title           String
  headline        String   @default("")
  intro           String   @default("")
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  seoKeywords     String   @default("")
  needs           String[]
  solutions       String[]
  features        Json     @default("[]")
  tips            String[]
  relatedStyles   String[]
  relatedMaterials String[]
  relatedCaseSlugs String[]
  ctaText         String   @default("Заказать бесплатный замер")
  ctaHref         String   @default("/contacts#form")
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
